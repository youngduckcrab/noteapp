# INFRA, docs/plans/01-infra.md 3.1, docs/plans/m5-7/01-infra.md 3.1
* text=auto eol=lf

*.png binary
*.jpg binary
*.ico binary
*.jar binary
*.wasm binary
*.pdf binary

pubspec.lock linguist-generated=true
*.g.dart linguist-generated=true

# Byte-exact web assets checked by sha256 (tool/web_assets.yaml, ws check R12).
app/web/drift_worker.js -text

# Scripts run on Linux / macOS runners keep LF (2차).
tool/chrome-fakemedia text eol=lf
*.sh text eol=lf
*.swift text eol=lf
Podfile text eol=lf
# Fonts, recording samples, DB fixtures (contract 7.4.5 v2.1)
*.ttf binary
*.otf binary
*.webm binary
*.m4a binary
*.sqlite binary

# On-device math model files: byte-exact (checked by SHA-256 in the app and
# in CI — hosting/models/*/SHA256SUMS).
*.onnx binary
hosting/models/** -text
*.gz binary
